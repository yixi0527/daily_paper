APP_NAME=Daily Paper Tracker
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
FRONTEND_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/daily_paper
SYNC_TIMEZONE=Asia/Shanghai
SYNC_HOUR=22
SYNC_MINUTE=0
SYNC_LOOKBACK_DAYS=60
SYNC_MAX_PAGES=5
SYNC_HTTP_TIMEOUT=30
SYNC_RETRY_ATTEMPTS=5
SYNC_RETRY_MAX_BACKOFF_SECONDS=10
SYNC_RATE_LIMIT_BACKOFF_SECONDS=10
SYNC_RATE_LIMIT_MAX_BACKOFF_SECONDS=60
SYNC_MIN_INTERVAL_SECONDS=1.5
HTTP_USER_AGENT="DailyPaperTracker/1.0 (+https://github.com/yixi0527/daily_paper; mailto:yixi0527@users.noreply.github.com)"
CROSSREF_MAILTO=yixi0527@users.noreply.github.com
RUN_SCHEDULER=false
EXPORT_STATIC_DATA_DIR=apps/web/public/data
ARTICLE_REGISTRY_FILE=packages/shared/data/article_registry.json
VITE_APP_MODE=live
VITE_API_BASE_URL=http://localhost:8000/api
VITE_STATIC_DATA_BASE=/data
VITE_STATIC_DATA_VERSION=local
VITE_GITHUB_PAGES_BASE=/
